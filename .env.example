# Set the real API key here locally, or in Vercel Environment Variables.
GEMINI_API_KEY=
GEMINI_MODEL=auto
# Existing Supabase public settings are defaults in app.py.
# To move projects later, set BOTH values and run the SQL in README.txt there.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_PUBLIC_KEY=YOUR_PUBLISHABLE_KEY
